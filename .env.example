# Salin ke .env pada root repositori dan isi nilai kosong sebelum menjalankan Compose.
# Isi kredensial lokal; simpan .env di luar commit Git.
# MQTT_USERNAME/MQTT_PASSWORD dipakai untuk pembuatan passwordfile dan pengujian klien.
# Mosquitto membaca passwordfile, bukan variabel ini secara otomatis.
TZ=Asia/Jakarta
MQTT_PORT=1883
MQTT_TLS_PORT=8883
NODE_RED_PORT=1880
INFLUXDB_PORT=8086
MQTT_USERNAME=kelompok10
MQTT_PASSWORD=
NODE_RED_CREDENTIAL_SECRET=
INFLUXDB_ADMIN_USER=
INFLUXDB_ADMIN_PASSWORD=
INFLUXDB_ORG=kelompok-10
INFLUXDB_BUCKET=traffic
INFLUXDB_ADMIN_TOKEN=
